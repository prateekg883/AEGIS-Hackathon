# Vite Frontend Environment Variables Template
# Copy this file to .env before starting the development server

# Google OAuth 2.0 Client ID for "Sign in with Google" (Optional)
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Backend API URL (default: local backend)
VITE_API_BASE_URL=http://localhost:8000
