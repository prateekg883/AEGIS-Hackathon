# A.E.G.I.S. (SAT-SA) — Environment Configuration Template
# Copy this file to .env and configure for your deployment.

# =================================================================
# 1. CORE APPLICATION CONFIGURATION
# =================================================================
APP_NAME=A.E.G.I.S API
APP_VERSION=0.1.0
APP_ENV=development
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=sqlite:///data/aegis_sat.db
MAX_UPLOAD_BYTES=5242880

# =================================================================
# 2. AUTHENTICATION & GMAIL EMAIL OTP CONFIGURATION
# =================================================================
# AUTH_MODE:
#   - 'AIR_GAPPED' : Complete isolation. Zero external email communication. Approved local authentication.
#   - 'EMAIL_OTP'  : Secure 6-digit OTP delivery to registered Gmail addresses via TLS SMTP.
AUTH_MODE=AIR_GAPPED

# Safety Control: When AIR_GAPPED_MODE=true, all outbound email/SMTP requests are strictly blocked at kernel/app boundary.
AIR_GAPPED_MODE=true

# Real Gmail SMTP Configuration (Required when AUTH_MODE=EMAIL_OTP)
# Note: Use a dedicated Google App Password (16 characters) generated under Google Account -> Security -> 2-Step Verification -> App passwords.
# NEVER commit real Gmail credentials to source code!
MAIL_PROVIDER=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-soc-alert-sender@gmail.com
SMTP_PASSWORD=your-google-app-password-placeholder
MAIL_FROM_ADDRESS=A.E.G.I.S. Security Enclave <your-soc-alert-sender@gmail.com>

# OTP Security Parameters
OTP_EXPIRATION_SECONDS=300
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN_SECONDS=0

# =================================================================
# 3. CRITICAL ESCALATION GATEWAY (ATTENTION SCORE 98-100)
# =================================================================
ESCALATION_ENABLED=false
CRITICAL_SCORE_THRESHOLD=98.0
DESTINATION_TYPE=AUTHORISED_EXTERNAL_ENDPOINT
DESTINATION_URL=https://authorized-endpoint.gov.in/api/v1/escalations
DESTINATION_AUTH_METHOD=HMAC_BEARER
DESTINATION_API_KEY=your-destination-api-key-placeholder
DESTINATION_HMAC_SECRET=your-hmac-sha256-signing-secret-placeholder

# =================================================================
# 4. REAL SIEM INTEGRATION (ELASTICSEARCH / ECS)
# =================================================================
SIEM_CONNECTOR_TYPE=ELASTICSEARCH
SIEM_ENDPOINT=https://your-elastic-deployment.internal:9200
SIEM_API_KEY=your-elastic-api-key-placeholder
SIEM_INDEX=.alerts-security.alerts-default,logs-*
SIEM_VERIFY_SSL=true
SIEM_POLL_INTERVAL_SECONDS=300
