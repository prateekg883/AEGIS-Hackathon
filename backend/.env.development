# Environment template for local development
# Copy to .env for development environment

APP_NAME=A.E.G.I.S API (Development)
APP_VERSION=0.1.0
APP_ENV=development

# Local SQLite is the default for development.
# Optional PostgreSQL override:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/aegis_sat

# Server binding
SERVER_HOST=127.0.0.1
SERVER_PORT=8000

# CORS - allow dev ports
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5000,http://127.0.0.1:5000

# File upload limit (5MB)
MAX_UPLOAD_BYTES=5242880

# Development mode (not offline)
OFFLINE_MODE=false
