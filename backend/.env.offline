# Environment template for offline/air-gapped deployment
# Copy to .env and customize for your environment

APP_NAME=A.E.G.I.S API
APP_VERSION=0.1.0
APP_ENV=offline

# Portable default: local SQLite, no PostgreSQL required.
# Leave DATABASE_URL unset to use backend/data/aegis_sat.db.
# Optional PostgreSQL override:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/aegis_sat

# Server binding - localhost only for air-gapped deployment
SERVER_HOST=127.0.0.1
SERVER_PORT=8000

# CORS - allow local frontend connections only
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5000,http://127.0.0.1:5000

# File upload limit (5MB)
MAX_UPLOAD_BYTES=5242880

# Offline mode indicator
OFFLINE_MODE=true
